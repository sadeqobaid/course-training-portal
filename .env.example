# Script name: .env.example
# Original location: .env.example
# What this script is: Example environment configuration file containing key=value pairs for application settings.
# What it is used for: Provides default local development and testing configuration values for services like the database, API server, frontend, JWT, CORS, reminders, and SMTP.
# Programming language: Source/configuration format (dotenv / key=value)
# Inputs: Environment variables defined here are read by the application at startup or by tooling that sources this file.
# Outputs: None (this file defines configuration only; it does not produce runtime outputs).
# Where output is saved or sent: None
# Technologies and services used or interacted with: PostgreSQL, SMTP (Mailpit/Mailhog), JWT, CORS, local frontend dev server (e.g., Vite), backend API server.
# Downstream scripts/files/processes that consume the output: Backend application server, database migration tools, email sending routines, frontend dev server, CI/local Docker compose setups.
# Risks and safe change note: Contains sensitive defaults (passwords and secrets); do not commit production secrets here, rotate/change before production, and verify changes do not break downstream consumers.
# created by: Sadeq Obaid

# Sets the PostgreSQL username the application will use to authenticate to the database.
POSTGRES_USER=portal
# Sets the PostgreSQL password for the POSTGRES_USER; this is sensitive and should be changed for non-local environments.
POSTGRES_PASSWORD=localpass
# Specifies the PostgreSQL database name the application will connect to or create.
POSTGRES_DB=training
# Complete database connection URL used by database clients/drivers; typically composed from the POSTGRES_* values above.
DATABASE_URL=postgresql://portal:localpass@localhost:5432/training
# Port number on which the backend API server should listen in development.
API_PORT=3000
# Port number for the frontend development server (commonly Vite) and typically matches CORS_ORIGIN's port.
WEB_PORT=5173
# Secret used to sign JWT access tokens; must be kept secret and replaced for production environments.
JWT_ACCESS_SECRET=local_secret_change_before_production
# Time-to-live for JWT access tokens; specifies token expiry duration (e.g., 15 minutes).
JWT_ACCESS_TTL=15m
# Allowed origin for Cross-Origin Resource Sharing; usually the frontend dev server origin during development.
CORS_ORIGIN=http://localhost:5173
# Business rule: number of days after an event to trigger a reminder; used by reminder scheduling logic.
REMINDER_AFTER_DAYS=7
# Business rule: cooldown period in days to avoid sending reminders too frequently to the same recipient.
REMINDER_COOLDOWN_DAYS=7
# SMTP host used for sending emails; 'mailpit' often points to a local mail testing service in development.
SMTP_HOST=mailpit
# SMTP port for the mail service; 1025 is commonly used by local mail testing tools like Mailpit or Mailhog.
SMTP_PORT=1025
# Default From address used in outgoing emails generated by the application.
SMTP_FROM=training-portal@example.test
